{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Project: Run Dev Server",
            "type": "shell",
            "command": "uv run python run.py",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Project: Setup All (Dependencies, DB, Migrations)",
            "type": "shell",
            "windows": {
                "command": ".\\setup.ps1"
            },
            "linux": {
                "command": "./setup.sh"
            },
            "osx": {
                "command": "./setup.sh"
            },
            "problemMatcher": []
        },
        {
            "label": "Project: Start Database (Docker)",
            "type": "shell",
            "command": "docker compose --env-file .env.development up -d db",
            "problemMatcher": []
        },
        {
            "label": "Project: Stop Database (Docker)",
            "type": "shell",
            "command": "docker compose --env-file .env.development down",
            "problemMatcher": []
        },
        {
            "label": "Project: Run Migrations",
            "type": "shell",
            "command": "uv run alembic upgrade head",
            "problemMatcher": []
        },
        {
            "label": "Project: Check (Lint & Typecheck)",
            "type": "shell",
            "command": "uv run ruff check . && uv run pyright",
            "problemMatcher": []
        }
    ]
}
