# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM & Multi-Provider Gateway Settings
# Default provider to route to: openai, groq, anthropic, gemini, mistral, deepseek, openrouter, ollama
DEFAULT_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-5.6-luna
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# Provider API Keys (Fill in what you use; unset providers are skipped automatically)
OPENAI_API_KEY="your-openai-api-key"
# OPENAI_BASE_URL=https://api.atlascloud.ai/v1  # Optional: For Atlas Cloud, vLLM, or custom proxies
# ANTHROPIC_API_KEY="your-anthropic-api-key"
# GEMINI_API_KEY="your-gemini-or-google-api-key"
# GROQ_API_KEY="your-groq-api-key"
# MISTRAL_API_KEY="your-mistral-api-key"
# DEEPSEEK_API_KEY="your-deepseek-api-key"
# OPENROUTER_API_KEY="your-openrouter-api-key"
# OLLAMA_BASE_URL="http://localhost:11434"

# JWT Settings
JWT_SECRET_KEY="CHANGE_ME_TO_A_RANDOM_32_PLUS_CHAR_STRING"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
# --- ChronaMind memory engine (V2-D93) -------------------------------------------------------------
# Empty MEMORY_ENGINE_URL means no long-term memory at all: there is no fallback to mem0 by design.
# MEMORY_ENGINE_TOKEN must be a *delegating* token on the engine host, so it can act for each end user:
#   CME_HOST_TOKENS='{"<MEMORY_ENGINE_TOKEN>": {"principal": "chronamind-app", "tier": "B", "delegate": true}}'
# The tier comes from the token; the app names the end user per call (docs/memory.md).
MEMORY_ENGINE_URL=
MEMORY_ENGINE_TOKEN=
# Single-valued facts (residence, employer, name) are recognised by a language model in any language (V2-D121).
# Exactly `llm` enables it; `off` (or any unrecognized value) records every claim as multi-valued, the safe side.
# An empty model name resolves to DEFAULT_LLM_MODEL; the classifier never falls back to another model (V2-D121).
MEMORY_SLOT_CLASSIFIER=llm
MEMORY_SLOT_CLASSIFIER_MODEL=

# --- Model provider: any OpenAI-compatible / Anthropic-Messages endpoint (V2-D94) -------------------
# The gateway serves one protocol per model family; `CME_LLM_PROTOCOL` overrides the family guess.
CME_LLM_BASE_URL=
CME_LLM_API_KEY=
CME_LLM_PROTOCOL=
CME_EXTRACTOR_MODEL=
CME_ADJUDICATOR_MODEL=
# Local ONNX embedding model for the dense arm: the provider may not serve /embeddings at all.
CME_EMBEDDING_ASSET=
CME_EMBEDDING_DIR=
