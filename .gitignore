# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
*.jsonl

# Virtual environments
.venv

# Environment variables
.env
.env.development
.env.staging
.env.production

# Misc
*.ipynb

# Reports
evals/reports/

# IDE / Agent configs. The project's own Claude config is tracked (`.claude/settings.json` and `.claude/skills/`, which
# the review workflow reads); everything else there is personal and stays local.
.claude/*
!.claude/settings.json
!.claude/NOTICE.md
!.claude/skills/
!.claude/skills/**
# ...but not the bytecode caches Python writes beside a skill's scripts
.claude/skills/**/__pycache__/
.cursor/
.vscode/
.agents/

# Local reference implementations of external memory engines (read-only research material)
reference-memory-engines/
