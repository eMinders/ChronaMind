# systemd timer exporting the erasure journal every five minutes (`V2-D122`): the journal's recovery point.
#
# Install alongside `cme-erasure-journal.service`:
#   sudo install -m 0644 deploy/cme-erasure-journal.service deploy/cme-erasure-journal.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cme-erasure-journal.timer
[Unit]
Description=ChronaMind memory engine — erasure journal export timer
Documentation=file:///opt/chronamind/custom-memory-engine/deploy/README.md

[Timer]
OnCalendar=*:0/5
Persistent=true
Unit=cme-erasure-journal.service

[Install]
WantedBy=timers.target
