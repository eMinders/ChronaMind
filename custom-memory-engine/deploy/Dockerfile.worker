# The slow-lane worker as a container image (V2-D103).
#
# Build from the repository root of custom-memory-engine:
#   docker build -f deploy/Dockerfile.worker -t chronamind/worker:dev .
#
# The image installs the `host` and `embeddings` extras — the worker embeds documents for the dense arm and speaks to the
# provider — and nothing else. It contains no credentials: every secret arrives through `--env-file`.
FROM python:3.12-slim-bookworm AS base

# onnxruntime needs libgomp; the rest of the base image is enough for psycopg's binary wheel.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 \
 && rm -rf /var/lib/apt/lists/*

# uv, pinned by digest-tagged version, is the project's own installer.
COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /usr/local/bin/uv

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1

# Dependencies first, so a source change does not re-install the world.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --extra host --extra embeddings

COPY src ./src
COPY scripts ./scripts
RUN uv sync --frozen --extra host --extra embeddings

# The model cache is mounted, not baked: 2.2 GB of weights belong to a volume the operator controls, and a rebuilt image
# must not silently carry a different model. `CME_EMBEDDING_DIR` points at it.
ENV CME_EMBEDDING_DIR=/models/bge-m3
VOLUME ["/models"]

# Run as a non-root user: the worker needs no privileges beyond its own files.
RUN useradd --create-home --uid 10001 chronamind \
 && chown -R chronamind:chronamind /app
USER chronamind

# The probe reads the queue rather than the process (scripts/worker_healthcheck.py): a worker alive but not draining is
# unhealthy, which is the failure this lane is most likely to have.
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD ["/app/.venv/bin/python", "scripts/worker_healthcheck.py"]

# SIGTERM is handled by run_worker.main: finish the job in flight, then exit. Docker's default stop signal is SIGTERM.
STOPSIGNAL SIGTERM
CMD ["/app/.venv/bin/python", "scripts/run_worker.py"]
