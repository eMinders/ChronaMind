# systemd timer triggering daily CME maintenance (`#255`, `A-014`, `V2-D119`).
#
# Install alongside `cme-maintenance.service`:
#   sudo install -m 0644 deploy/cme-maintenance.service deploy/cme-maintenance.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cme-maintenance.timer
[Unit]
Description=ChronaMind memory engine — daily maintenance timer
Documentation=file:///opt/chronamind/custom-memory-engine/deploy/README.md

[Timer]
OnCalendar=daily
RandomizedDelaySec=15m
Persistent=true
Unit=cme-maintenance.service

[Install]
WantedBy=timers.target
