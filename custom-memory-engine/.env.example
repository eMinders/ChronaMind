# Disposable local test credentials only; never reuse product DB credentials.
CME_TEST_DB_PASSWORD=cme_disposable_local_only
CME_TEST_DB_PORT=5433
CME_TEST_DATABASE_URL=postgresql://cme_test:cme_disposable_local_only@127.0.0.1:5433/cme_compatibility

# Research-lab runtime settings (explicit RL_* prefix; never reuse product .env)
RL_DATABASE_URL=postgresql://cme_test:cme_disposable_local_only@127.0.0.1:5433/cme_compatibility
RL_LLM_MODEL=gpt-4o-mini-2024-07-18
RL_LLM_API_KEY=replace-with-provider-api-key
RL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# --- Model provider (V2-D94). Placeholders only; real values live in .env, which is gitignored. ---------
CME_LLM_BASE_URL=
CME_LLM_API_KEY=
CME_LLM_PROTOCOL=
# Measured selection (`reports/model_selection/README.md`, V2-D102):
CME_EXTRACTOR_MODEL=gpt-6.2-sol
CME_ADJUDICATOR_MODEL=gpt-6.2-sol
# Local ONNX embedding model: name one of integrations.onnx_embedder.KNOWN_ASSETS
CME_EMBEDDING_ASSET=
CME_EMBEDDING_DIR=
# Optional relevance judge on the read path (V2-D104): `bge-reranker-v2-m3`, fetched by scripts/fetch_models.py.
# The floor defaults to the measured -8.8; change it only after re-measuring (reports/retrieval/README.md).
CME_RERANKER_ASSET=
CME_RERANKER_DIR=
CME_RERANKER_FLOOR=

# --- Host (E-046) ------------------------------------------------------------------------------------
CME_DATABASE_URL=
CME_RUNTIME_ROLE=
CME_SCHEMA=cme_engine
# JSON: {"<token>": {"principal": "...", "tier": "B"|"C", "admin": false}}
CME_HOST_TOKENS=
CME_HOST_HOST=127.0.0.1
CME_HOST_PORT=8100
# >= 32 characters each; must be identical across restarts or evidence signatures will not verify
CME_PROVENANCE_KEY=
CME_DELETION_RECEIPT_KEY=

# --- Slow lane (E-047) and worker deployment (V2-D103; `deploy/README.md`) ---------------------------
# The principals this worker serves. The queue is tenant-scoped, so this is the worker's whole remit.
CME_WORKER_USERS=
# 0 disables both adjudicators (relation and entity); default on. Seconds between idle polls (also the lease
# recovery cadence).
CME_ADJUDICATE=1
CME_WORKER_IDLE_POLL=5
